# NOWMe 生产环境变量模板。复制为 .env（不入库）后填写；docker-compose.yml 通过 env_file 读取它。
# 全部变量的含义见 .env.example 与 docs/deploy.md。这里只列生产必需项与常用项，不含任何真实值。
# 生产环境（NODE_ENV=production）启动前会检查配置，下面标“必填”的有问题时进程拒绝启动并一次列出全部问题。

# ---- 源（必填，必须是 https）----
# 主站与用户页面托管是两个不同的站点。强烈建议页面托管用单独注册的域名
# （不是主站的子域名；类似 githubusercontent.com 的做法），否则同站 cookie 隔离会变弱。
NOWME_WEB_ORIGIN=https://nowme.example.com
NOWME_PAGES_ORIGIN=https://nowme-pages.example.net

# ---- 反向代理 ----
# 进程前面可信反向代理的层数（Caddy / Nginx 一层就写 1）。大于 0 时来源地址取 X-Forwarded-For 从右数第 N 个，
# 并接受代理传来的 X-Request-Id。写 0 会让所有请求被当成同一个来源地址，按地址限流会误伤正常用户。
NOWME_TRUST_PROXY=1

# ---- 密钥（必填）----
# 页面票据 HMAC 密钥，主站与页面托管必须一致，至少 32 个字符：openssl rand -base64 48
# 页面托管容器以只读方式挂载数据卷，不能依赖自动生成的 secret 文件，所以这里必须设置。
NOWME_TICKET_SECRET=
# 用户模型 Key 的加密主密钥，64 位十六进制：openssl rand -hex 32
# 必须单独备份（不在数据备份里）；丢失后用户保存的 Key 无法解密。所有主站 / worker 实例使用同一个值。
NOWME_AI_ENCRYPTION_KEY=

# ---- 登录邮件（必填：生产环境只允许 smtp）----
NOWME_MAIL_TRANSPORT=smtp
# smtps://用户:密码@主机:465（隐式 TLS）或 smtp://用户:密码@主机:587（STARTTLS）；特殊字符要百分号编码。这是密钥。
NOWME_SMTP_URL=
# 发件人，例如 NOWMe <no-reply@example.com>；域名需要配置 SPF / DKIM
NOWME_MAIL_FROM=

# ---- 数据与备份 ----
# 容器内数据目录由 compose 固定为 /data（挂载具名卷 nowme-data），一般不用改。
# NOWME_DATA_DIR=/data
# 备份：容器内写到 /backups（compose 的 backup 服务已设置），宿主机目录用 NOWME_BACKUP_HOST_DIR 指定；保留份数默认 7。
# NOWME_BACKUP_HOST_DIR=./backups
# NOWME_BACKUP_KEEP=7

# ---- 平台 AI 与点数（可选；留空则只有自带 Key 的用户能用 AI）----
# 服务：anthropic、openai、deepseek、qwen、zhipu、moonshot、doubao、gemini、openrouter、siliconflow、openai-compatible
NOWME_PLATFORM_PROVIDER=
# 设置了 NOWME_PLATFORM_PROVIDER 就必须设置 Key。这是密钥：只从环境变量读，不入库、不写日志。
NOWME_PLATFORM_API_KEY=
NOWME_PLATFORM_BASE_URL=
NOWME_PLATFORM_MODEL=
NOWME_PLATFORM_INTERVIEW_MODEL=
NOWME_PLATFORM_VISION=
NOWME_PRICE_GENERATE=10
NOWME_PRICE_EDIT=4
NOWME_SIGNUP_CREDITS=0
NOWME_PLATFORM_FREE_DAILY_CALLS=3000

# ---- 资源保护（可选，默认值如下）----
NOWME_HOSTED_MAX_TURNS=30
NOWME_HOSTED_DAILY_ATTEMPTS=10
NOWME_INTERVIEW_DAILY_CALLS=20
NOWME_AGENT_TOKEN_TTL_HOURS=72

# ---- Skill 市场渠道（可选，两个变量同时设置才生效）----
NOWME_SKILL_MARKET_LABEL=
NOWME_SKILL_MARKET_COMMAND=

# 以下变量在生产环境不要设置：NOWME_MODEL_FAKE、NOWME_CLAUDE_FAKE（假模型，生产拒绝）、NOWME_AI_ALLOW_LOCAL（生产忽略）。
# NODE_ENV、NOWME_WEB_LISTEN、NOWME_PAGES_LISTEN 由 docker-compose.yml 设置。
