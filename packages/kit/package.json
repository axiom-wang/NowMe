{
  "name": "@nowme/kit",
  "version": "0.0.0",
  "private": true,
  "description": "NOWMe Kit：nowme.css、nowme.js、组件与字体清单",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "static",
    "fonts.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fonts:fetch": "tsx --conditions=source scripts/fetch-fonts.ts"
  },
  "dependencies": {
    "@nowme/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "acorn": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
