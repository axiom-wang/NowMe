# Skill 包（pnpm --filter @nowme/skill pack:skill 生成，由主站 /skill 托管）
skill/dist-package/

# 营销素材（本地保存，不纳入 git）
marketing/

backups/

# 部署到服务器用的环境文件（含密钥）
deploy/*.env
