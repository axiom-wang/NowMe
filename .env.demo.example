# 将需要的条目复制到未跟踪的 .env.local；不要填写真实 Key 到本文件。
NOWME_AI_ENCRYPTION_KEY=<64位十六进制随机主密钥>
# 同一服务用于采访与生成（模型必须支持工具调用）
NOWME_DEMO_PROVIDER=<服务商标识，例如deepseek>
NOWME_DEMO_BASE_URL=<公网HTTPS的API根地址>
NOWME_DEMO_MODEL=<模型名>
NOWME_DEMO_API_KEY=<维护者的真实APIKey>
NOWME_DEMO_VISION=0
# 可选：按角色覆盖任一条，其余沿用公共条目；角色专用服务应同时配置该服务的Key。
# NOWME_DEMO_INTERVIEW_PROVIDER=<采访服务商>
# NOWME_DEMO_INTERVIEW_BASE_URL=<采访API根地址>
# NOWME_DEMO_INTERVIEW_MODEL=<采访模型>
# NOWME_DEMO_INTERVIEW_API_KEY=<采访APIKey>
# NOWME_DEMO_INTERVIEW_VISION=0
# NOWME_DEMO_GENERATE_PROVIDER=<生成服务商>
# NOWME_DEMO_GENERATE_BASE_URL=<生成API根地址>
# NOWME_DEMO_GENERATE_MODEL=<生成模型>
# NOWME_DEMO_GENERATE_API_KEY=<生成APIKey>
# NOWME_DEMO_GENERATE_VISION=0
# 可选：本机代理若将域名解析为 198.18.* fake-IP，显式指定独立DNS。
# 仍逐次解析 A/AAAA 并验证公网地址、固定连接地址，不放开保留地址。
# NOWME_DEMO_DNS_SERVERS=<DNS服务器IP，多个以逗号分隔>
