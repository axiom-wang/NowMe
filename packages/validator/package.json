{
  "name": "@nowme/validator",
  "version": "0.0.0",
  "private": true,
  "description": "NOWMe 页面静态校验（纯函数）",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nowme/contracts": "workspace:*",
    "acorn": "catalog:",
    "parse5": "catalog:",
    "postcss": "catalog:",
    "postcss-safe-parser": "catalog:",
    "postcss-value-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
