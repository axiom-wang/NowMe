# NOWMe 环境变量（复制为 .env 后修改；.env 不入库）。
# 主站与页面托管启动时会载入仓库根的 .env，已在 shell 中设置的变量优先。
# 默认值见 packages/contracts（loadConfig），与 docs/contracts.md 0.1 一致。

# 主站源。默认 http://localhost:3000，监听端口取自这里。
NOWME_WEB_ORIGIN=http://localhost:3000

# 页面托管源。默认 http://127.0.0.1:4000。
# 必须与主站是不同主机（localhost / 127.0.0.1），因为 cookie 不按端口隔离。
NOWME_PAGES_ORIGIN=http://127.0.0.1:4000

# 本地数据目录：db.sqlite、revisions/<revisionId>/、outbox.log、secret。
# 相对路径按仓库根解析。默认 .data
NOWME_DATA_DIR=.data

# 页面票据的 HMAC 密钥（主站签发、页面托管校验，两边必须一致），至少 32 个字符。
# 留空时两边共用 <NOWME_DATA_DIR>/secret（首次启动自动生成，权限 0600）。
NOWME_TICKET_SECRET=

# 一次性 Agent token 有效期（小时，1–720）。默认 72
NOWME_AGENT_TOKEN_TTL_HOURS=72

# nowme CLI 的本地目录（凭证 credentials、长期画像 profile.md）。默认 ~/.nowme；测试与演练时改到别处。
NOWME_HOME=

# production 时关闭 /dev/outbox 等开发功能，并在启动前检查配置（见下面“部署”一节）。默认 development
NODE_ENV=development

# ---- 部署（docs/contracts.md 第 10 节）----
# 进程实际监听的地址：端口、主机:端口 或 [IPv6]:端口。留空时由上面的源推导（本地开发）。
# 部署在反向代理之后时，源写对外的 https 域名，这里写进程监听的地址，例如 0.0.0.0:3000 / 0.0.0.0:4000。
NOWME_WEB_LISTEN=
NOWME_PAGES_LISTEN=
# 进程前面可信反向代理的层数（0–5）。大于 0 时，来源地址取 X-Forwarded-For 从右数第 N 个，用于按地址限流。
# 没有反向代理时保持 0：此时忽略 X-Forwarded-For（这个头任何人都能伪造）。
NOWME_TRUST_PROXY=0
# 生产环境（NODE_ENV=production）启动前会检查并一次列出全部问题，有错误就拒绝启动：
# - 两个源都必须是 https；
# - 主站必须有 NOWME_AI_ENCRYPTION_KEY；
# - 主站必须用 NOWME_MAIL_TRANSPORT=smtp（否则真实用户收不到验证码）。
# 另外建议：给用户页面单独注册一个域名（不要用主站的子域名）、显式设置 NOWME_TICKET_SECRET。

# ---- 登录验证码邮件（docs/contracts.md 10.2）----
# file：写进 <NOWME_DATA_DIR>/outbox.log，本地在 /dev/outbox 查看（默认）；smtp：真实发送。
NOWME_MAIL_TRANSPORT=file
# SMTP 连接串：smtps://用户:密码@主机:465（隐式 TLS）或 smtp://用户:密码@主机:587（生产环境强制 STARTTLS）。
# 用户名和密码里的特殊字符要百分号编码（@ 写成 %40）。这是密钥：不要写进日志或提交进仓库。
NOWME_SMTP_URL=
# 发件人，例如 NOWMe <no-reply@example.com>。域名需要在发信服务商那里完成验证（SPF / DKIM），否则容易进垃圾箱。
NOWME_MAIL_FROM=

# ---- 网页内自带 AI API（docs/hosted-route.md 第 1 节）----
# 用户可以在 /account/ai 保存自己的服务、模型和 Key；平台 AI（扣点数）只由 NOWME_PLATFORM_* 配置，不从旧模型环境变量回退。
# 凭证库主密钥：64 位十六进制（32 字节随机值），仅主站需要。可用 openssl rand -hex 32 生成。
# 必须备份并安全保管；所有主站实例使用同一密钥。缺失时禁用凭证保存/调用，绝不明文存储。
# 直接更换会使已有凭证无法解密；轮换时须先完成重加密迁移，或由用户重新填写 Key。
NOWME_AI_ENCRYPTION_KEY=
# 仅开发环境可显式允许回环模型（Ollama 等），地址指向服务器所在电脑，不是访问者电脑。
# 生产环境忽略此开关；内网、链路本地地址和云元数据地址仍然禁止。
NOWME_AI_ALLOW_LOCAL=0
# 资源保护限制，不是付费额度；模型费用由用户向服务商支付，失败请求也可能计费。
NOWME_HOSTED_MAX_TURNS=30
NOWME_HOSTED_DAILY_ATTEMPTS=10
NOWME_INTERVIEW_DAILY_CALLS=20
# 确定性假模型仅用于开发/测试，生产环境拒绝；旧名 NOWME_CLAUDE_FAKE 兼容。
NOWME_MODEL_FAKE=

# ---- 平台 AI 与点数（docs/contracts.md 第 12 节）----
# 设置后，没有自己模型 Key 的用户用平台的 AI：采访与“和 TA 聊什么”不收点数，生成 / 修改页面按下面的价目扣点数。
# 填了自己 Key 的用户仍然用自己的，不消耗点数。留空则不开放平台 AI（只有自带 Key 的用户能用 AI）。
# 模型服务：anthropic、openai、deepseek、qwen、zhipu、moonshot、doubao、gemini、openrouter、siliconflow、openai-compatible
NOWME_PLATFORM_PROVIDER=
# 平台模型的 API key。这是密钥：只从环境变量读，不入库、不写日志、不在任何页面显示。
NOWME_PLATFORM_API_KEY=
# 可选：服务地址（必须是公网 HTTPS）、生成模型、采访模型（留空用服务预设）、是否把图片交给模型（0 / 1）。
NOWME_PLATFORM_BASE_URL=
NOWME_PLATFORM_MODEL=
NOWME_PLATFORM_INTERVIEW_MODEL=
NOWME_PLATFORM_VISION=
# 价目（点数）：生成一版页面、修改一次。没做出新版本的任务全额退回。设为 0 表示不收。
NOWME_PRICE_GENERATE=10
NOWME_PRICE_EDIT=4
# 新用户注册赠送的点数。默认 0
NOWME_SIGNUP_CREDITS=0
# 平台 AI 免费调用（采访、和 TA 聊什么）的全站每日上限，防止批量注册消耗平台的模型费用。
NOWME_PLATFORM_FREE_DAILY_CALLS=3000
# 点数从哪来：运营用脚本生成兑换码或直接发放（明文只输出一次，库里只存哈希）
#   pnpm --filter @nowme/web credits codes --count 20 --credits 100 --batch "2026-12 招新"
#   pnpm --filter @nowme/web credits grant --email someone@example.com --credits 50

# ---- Skill 分发（docs/contracts.md 4.5）----
# Skill 市场渠道：两个变量同时设置时，/skill 安装页与 install.md 多显示一种安装方式；都留空则只提供主站下载。
# 例如 NOWME_SKILL_MARKET_LABEL=SkillHub、NOWME_SKILL_MARKET_COMMAND=npx skills add nowme/nowme-page
NOWME_SKILL_MARKET_LABEL=
NOWME_SKILL_MARKET_COMMAND=

# ---- 内容安全与协议（docs/contracts.md 16）----
# 内置规则总是生效。下面三项都是可选的补充。
# 外部词表文件：每行一个词或 /正则/，# 开头是注释；相对路径按仓库根解析。文件读不到或有一行不合法时，主站拒绝启动。
NOWME_BLOCKLIST_FILE=
# 外部审核接口（默认关闭）：只允许公网 HTTPS。主站 POST {"kind","text"}，期望返回 {"allowed":true|false,"rule":"可选编号"}。
# 密钥（可选）放 NOWME_MODERATION_API_KEY，以 Bearer 头发送。启用后隐私政策会写明文字会发给审核服务。
NOWME_MODERATION_URL=
NOWME_MODERATION_API_KEY=
# 审核接口超时或出错时：allow 放行并记日志（默认）；block 拦截。
NOWME_MODERATION_ON_FAILURE=allow
# 运营方联系邮箱，显示在用户协议与隐私政策里（可选）。
NOWME_CONTACT_EMAIL=
