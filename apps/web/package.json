{
  "name": "@nowme/web",
  "version": "0.0.0",
  "private": true,
  "description": "NOWMe 主站",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/app.tsx",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "static"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch --conditions=source --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "start:source": "tsx --conditions=source --disable-warning=ExperimentalWarning src/main.ts",
    "seed": "tsx --conditions=source --disable-warning=ExperimentalWarning scripts/seed.ts",
    "demo": "tsx --conditions=source --disable-warning=ExperimentalWarning scripts/demo.ts",
    "stats": "tsx --conditions=source --disable-warning=ExperimentalWarning scripts/stats.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@nowme/contracts": "workspace:*",
    "@nowme/kit": "workspace:*",
    "@nowme/render": "workspace:*",
    "@nowme/skill": "workspace:*",
    "@nowme/validator": "workspace:*",
    "hono": "catalog:",
    "qrcode": "catalog:"
  },
  "devDependencies": {
    "@nowme/pages-host": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "parse5": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
