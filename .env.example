# NOWMe 环境变量（复制为 .env 后修改；.env 不入库）。
# 主站与页面托管启动时会载入仓库根的 .env，已在 shell 中设置的变量优先。
# 默认值见 packages/contracts（loadConfig），与 docs/contracts.md 0.1 一致。

# 主站源。默认 http://localhost:3000，监听端口取自这里。
NOWME_WEB_ORIGIN=http://localhost:3000

# 页面托管源。默认 http://127.0.0.1:4000。
# 必须与主站是不同主机（localhost / 127.0.0.1），因为 cookie 不按端口隔离。
NOWME_PAGES_ORIGIN=http://127.0.0.1:4000

# 本地数据目录：db.sqlite、revisions/<revisionId>/、outbox.log、secret。
# 相对路径按仓库根解析。默认 .data
NOWME_DATA_DIR=.data

# 页面票据的 HMAC 密钥（主站签发、页面托管校验，两边必须一致），至少 32 个字符。
# 留空时两边共用 <NOWME_DATA_DIR>/secret（首次启动自动生成，权限 0600）。
NOWME_TICKET_SECRET=

# 一次性 Agent token 有效期（小时，1–720）。默认 72
NOWME_AGENT_TOKEN_TTL_HOURS=72

# nowme CLI 的本地目录（凭证 credentials、长期画像 profile.md）。默认 ~/.nowme；测试与演练时改到别处。
NOWME_HOME=

# production 时关闭 /dev/outbox 等开发功能。默认 development
NODE_ENV=development
